amends "pkl:Project"

package {
  name = "{{frameworkName}}"
  version = "$pklPackageVersion"
  baseUri = "package://github.com/pklhub/pkl-frameworks/releases/download/v\\(version)/\\(name)"
  packageZipUrl = "https://github.com/pklhub/pkl-frameworks/releases/download/v\\(version)/\\(name)@\\(version).zip"
  sourceCode = "https://github.com/pklhub/pkl-frameworks"
  license = "Apache-2.0"
  exclude { "dist/**" }
}

dependencies {
  ["k8s-app"] { uri = "package://github.com/pklhub/pkl-k8s-app/releases/download/v0.25.0/pkl-k8s-app@0.25.0" }
}
